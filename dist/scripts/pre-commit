#!/usr/bin/env bash
# =============================================================================
# scripts/pre-commit
# =============================================================================
# Pre-commit hook for the Agents-Opencode-Jake repository.
#
# Runs three checks before allowing a commit:
#   1. opencode.json is valid JSON
#   2. opencode.json conforms to opencode.schema.json
#   3. Pytest fast suite (skips test_agents_runtime.py, which is slow)
#
# This file is checked into git. It is installed into .git/hooks/pre-commit
# by running: bash scripts/install-hook.sh
#
# To bypass this hook for a single commit:  git commit --no-verify
#
# -----------------------------------------------------------------------------
# STRICT MODE
# -----------------------------------------------------------------------------
# Set the environment variable STRICT_PRECOMMIT=1 to upgrade the pytest
# check from "warn and skip" to "fail the commit" when pytest or a Python
# interpreter is missing. This is intended for CI environments and for
# developers who want the hook to be fully enforcing.
#
#   STRICT_PRECOMMIT=1 bash scripts/pre-commit
#
# In strict mode the hook will EXIT 1 (blocking the commit) if:
#   - no Python interpreter is found on PATH, or
#   - `import pytest` fails (pytest is not installed).
#
# The default (gradual-adoption) behaviour is unchanged: a missing Python
# or pytest is treated as WARN and the commit proceeds.
# =============================================================================

set -e

# -----------------------------------------------------------------------------
# Color codes — only emitted when stdout is a TTY, so redirected logs stay clean
# -----------------------------------------------------------------------------
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BOLD='\033[1m'
    RESET='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BOLD=''
    RESET=''
fi

# -----------------------------------------------------------------------------
# Locate the git repository root (works from any subdirectory or cwd)
# -----------------------------------------------------------------------------
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$REPO_ROOT" ]]; then
    echo -e "${RED}PRE-COMMIT: cannot determine git repository root. Aborting.${RESET}"
    exit 1
fi
cd "$REPO_ROOT"

# -----------------------------------------------------------------------------
# Find a working Python interpreter.
# The task spec calls for `python` (Windows default), but Linux/Mac and some
# Windows git-bash setups only ship `python3`. We try `python` first, then
# `python3`, then the Windows `py` launcher. The first one that resolves and
# can run a one-liner wins. PY is unset if nothing works (we then WARN).
# -----------------------------------------------------------------------------
PY=""
for candidate in python python3 py; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
        PY="$candidate"
        break
    fi
done

# -----------------------------------------------------------------------------
# Header
# -----------------------------------------------------------------------------
echo -e "${BOLD}============================================================${RESET}"
echo -e "${BOLD}  PRE-COMMIT checks for Agents-Opencode-Jake${RESET}"
echo -e "${BOLD}============================================================${RESET}"

FAILURES=0

# -----------------------------------------------------------------------------
# Strict mode toggle
#
# When STRICT_PRECOMMIT=1, the pytest check fails the commit instead of
# warning if pytest or a Python interpreter is unavailable. All other
# checks (JSON validity, schema validation) already fail the commit on
# error, so strict mode only changes the missing-pytest path.
# -----------------------------------------------------------------------------
if [[ "${STRICT_PRECOMMIT:-}" == "1" ]]; then
    STRICT_MODE=1
else
    STRICT_MODE=0
fi

# -----------------------------------------------------------------------------
# Check 1: opencode.json is valid JSON
# Command (per spec):
#   python -c "import json; json.load(open('opencode.json'))"
# -----------------------------------------------------------------------------
echo -n "[1/4] Validating opencode.json (JSON syntax) ... "
if [[ -z "$PY" ]]; then
    echo -e "${YELLOW}SKIP${RESET}  (no python interpreter on PATH)"
elif [[ ! -f "opencode.json" ]]; then
    echo -e "${YELLOW}SKIP${RESET}  (file not found)"
elif "$PY" -c "import json; json.load(open('opencode.json'))" 2>/dev/null; then
    echo -e "${GREEN}OK${RESET}"
else
    echo -e "${RED}FAIL${RESET}"
    echo -e "  ${RED}opencode.json is not valid JSON.${RESET}"
    echo -e "  ${RED}Details:${RESET}"
    "$PY" -c "import json; json.load(open('opencode.json'))" 2>&1 | sed 's/^/    /' || true
    FAILURES=$((FAILURES + 1))
fi

# -----------------------------------------------------------------------------
# Check 2: opencode.json conforms to opencode.schema.json
# Command (per spec):
#   python -c "import jsonschema, json; jsonschema.validate(json.load(open('opencode.json')), json.load(open('opencode.schema.json')))"
# -----------------------------------------------------------------------------
echo -n "[2/4] Validating opencode.json against opencode.schema.json ... "
if [[ -z "$PY" ]]; then
    echo -e "${YELLOW}SKIP${RESET}  (no python interpreter on PATH)"
elif [[ ! -f "opencode.json" || ! -f "opencode.schema.json" ]]; then
    echo -e "${YELLOW}SKIP${RESET}  (opencode.json and/or opencode.schema.json not found)"
elif "$PY" -c "import jsonschema, json; jsonschema.validate(json.load(open('opencode.json')), json.load(open('opencode.schema.json')))" 2>/dev/null; then
    echo -e "${GREEN}OK${RESET}"
else
    echo -e "${RED}FAIL${RESET}"
    echo -e "  ${RED}opencode.json does not conform to opencode.schema.json.${RESET}"
    echo -e "  ${RED}Details:${RESET}"
    "$PY" -c "import jsonschema, json; jsonschema.validate(json.load(open('opencode.json')), json.load(open('opencode.schema.json')))" 2>&1 | sed 's/^/    /' || true
    FAILURES=$((FAILURES + 1))
fi

# -----------------------------------------------------------------------------
# Check 3: Pytest fast suite
# Command (per spec):
#   python -m pytest tests/test_setup.py tests/test_agents_v2.py
#                          tests/test_integration.py tests/test_schema.py
#                          tests/test_conductor_workflow.py
# (test_agents_runtime.py is intentionally skipped — it is slow.)
# -----------------------------------------------------------------------------
echo "[3/4] Running pytest (fast suite)..."

if [[ -z "$PY" ]]; then
    if [[ $STRICT_MODE -eq 1 ]]; then
        echo -e "  ${RED}FAIL${RESET}: no python interpreter on PATH; STRICT_PRECOMMIT=1 requires tests."
        echo -e "  ${RED}Install Python 3 and re-run, or unset STRICT_PRECOMMIT.${RESET}"
        FAILURES=$((FAILURES + 1))
    else
        echo -e "  ${YELLOW}WARN${RESET}: no python interpreter on PATH; skipping tests."
    fi
elif ! "$PY" -c "import pytest" 2>/dev/null; then
    if [[ $STRICT_MODE -eq 1 ]]; then
        echo -e "  ${RED}FAIL${RESET}: pytest not installed; STRICT_PRECOMMIT=1 requires tests."
        echo -e "  ${RED}Install with: pip install pytest jsonschema${RESET}"
        FAILURES=$((FAILURES + 1))
    else
        echo -e "  ${YELLOW}WARN${RESET}: pytest not installed; skipping tests (gradual adoption)."
        echo -e "  ${YELLOW}Install with: pip install pytest jsonschema${RESET}"
    fi
else
    # Run pytest, capture both output and exit code without aborting under set -e
    set +e
    PYTEST_OUTPUT=$("$PY" -m pytest tests/test_setup.py tests/test_agents_v2.py tests/test_integration.py tests/test_schema.py tests/test_conductor_workflow.py 2>&1)
    PYTEST_RC=$?
    set -e
    # Echo captured output so the user sees pytest's results
    echo "$PYTEST_OUTPUT"

    # The project uses --continue-on-collection-errors because legacy test files
    # (test_setup.py, test_integration.py) call sys.exit(0) at module level.
    # This causes pytest to return non-zero even when all *actual* tests pass.
    # We treat the run as PASSED if the summary shows zero test failures
    # (i.e., no "N failed" where N >= 1). Collection "errors" in the summary are
    # tolerated per the project's pytest.ini configuration.
    SUMMARY=$(echo "$PYTEST_OUTPUT" | grep -E '[0-9]+ (passed|failed|error)' | tail -1)
    if [[ -z "$SUMMARY" ]]; then
        SUMMARY=$(echo "$PYTEST_OUTPUT" | tail -1)
    fi

    if [[ $PYTEST_RC -eq 0 ]]; then
        echo
        echo -e "${GREEN}[3/4] pytest: PASSED${RESET}"
    elif echo "$SUMMARY" | grep -qE '[1-9][0-9]* failed'; then
        FAILED_COUNT=$(echo "$SUMMARY" | grep -oE '[1-9][0-9]* failed' | grep -oE '[1-9][0-9]*' | head -1)
        echo
        echo -e "${RED}[3/4] pytest: FAILED${RESET}  (${FAILED_COUNT} test(s) failed; exit code: $PYTEST_RC)"
        FAILURES=$((FAILURES + 1))
    else
        # Non-zero exit but no actual test failures — only collection errors
        # from legacy sys.exit(0) tests. Tolerated per pytest.ini policy.
        echo
        echo -e "${YELLOW}[3/4] pytest: PASSED (with collection warnings)${RESET}"
        echo -e "  ${YELLOW}Note: pytest reported collection errors but 0 test failures.${RESET}"
        echo -e "  ${YELLOW}These are tolerated (--continue-on-collection-errors in pytest.ini).${RESET}"
        echo -e "  ${YELLOW}Layer 2 task #9 will refactor legacy tests to remove sys.exit(0).${RESET}"
    fi
fi

# -----------------------------------------------------------------------------
# Check 4: Verify any active plan files
# -----------------------------------------------------------------------------
# If plans are being modified in this commit, run verify-plan.py on each.
# Archived plans in completed/ are also re-verified to ensure no regressions.
ACTIVE_PLANS=$(find .opencode/plans -maxdepth 2 -name "plan-*.md" -not -path "*/completed/*" 2>/dev/null)
COMPLETED_PLANS=$(find .opencode/plans/completed -name "plan-*.md" 2>/dev/null)
ALL_PLANS="$ACTIVE_PLANS $COMPLETED_PLANS"

if [[ -n "$ALL_PLANS" ]]; then
    echo
    echo "[4/4] Verifying plan files..."
    PLAN_FAIL=0
    for plan in $ALL_PLANS; do
        # Skip plans that aren't staged in this commit (only verify what's changing)
        if ! git diff --cached --name-only | grep -q "^$plan\$"; then
            continue
        fi
        if "$PY" scripts/verify-plan.py "$plan" >/dev/null 2>&1; then
            echo -e "  ${GREEN}OK${RESET}  $plan"
        else
            echo -e "  ${RED}FAIL${RESET}  $plan"
            echo -e "  ${RED}Run '$PY scripts/verify-plan.py $plan' to see details${RESET}"
            PLAN_FAIL=$((PLAN_FAIL + 1))
        fi
    done
    if [[ $PLAN_FAIL -gt 0 ]]; then
        echo -e "  ${RED}$PLAN_FAIL plan file(s) failed verification${RESET}"
        if [[ "${STRICT_PRECOMMIT:-0}" == "1" ]]; then
            FAILURES=$((FAILURES + 1))
        else
            echo -e "  ${YELLOW}WARN: plan verification failed (set STRICT_PRECOMMIT=1 to block commits)${RESET}"
        fi
    else
        echo -e "  ${GREEN}[4/4] plan verification: PASSED${RESET}"
    fi
fi

# -----------------------------------------------------------------------------
# Result
# -----------------------------------------------------------------------------
echo -e "${BOLD}------------------------------------------------------------${RESET}"
if [[ $FAILURES -gt 0 ]]; then
    echo -e "${RED}PRE-COMMIT FAILED: ${FAILURES} check(s) failed.${RESET}"
    echo -e "${RED}Commit blocked. Fix the issues above and try again.${RESET}"
    echo -e "${YELLOW}To skip this hook (not recommended): git commit --no-verify${RESET}"
    exit 1
else
    echo -e "${GREEN}PRE-COMMIT PASSED. Proceeding with commit.${RESET}"
    exit 0
fi
