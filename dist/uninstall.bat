@echo off
setlocal enabledelayedexpansion

title Agents-Opencode-Jake — Local Uninstall

set "REPO_DIR=%~dp0"

echo ============================================
echo  Agents-Opencode-Jake — Local Uninstall
echo ============================================
echo.
echo  Repo: %REPO_DIR%
echo.
echo  This will remove local project setup from this repo only.
echo  It will NOT affect other projects or global config.
echo.

set /p CONFIRM=Continue with local uninstall? (y/N): 
if /i not "!CONFIRM!"=="y" (
    echo  Aborted.
    pause
    exit /b 0
)
echo.

:: ---- Step 1: Remove pre-commit hook ----
echo [1/4] Removing pre-commit hook...
if exist "%REPO_DIR%.git\hooks\pre-commit" (
    del "%REPO_DIR%.git\hooks\pre-commit"
    echo  Removed: .git\hooks\pre-commit
) else (
    echo  [SKIP] No pre-commit hook found.
)
echo.

:: ---- Step 2: Clean .opencode structure ----
echo [2/4] Cleaning .opencode structure...
echo.
echo  The following can be regenerated by running setup.bat again.
echo.
set /p REMOVE_OPCODE=Remove .opencode/ directory (plans, decisions, work-log)? (y/N): 
if /i "!REMOVE_OPCODE!"=="y" (
    if exist "%REPO_DIR%.opencode\plans" (
        rmdir /S /Q "%REPO_DIR%.opencode\plans"
        echo  Removed: .opencode\plans\
    )
    if exist "%REPO_DIR%.opencode\decisions" (
        rmdir /S /Q "%REPO_DIR%.opencode\decisions"
        echo  Removed: .opencode\decisions\
    )
    if exist "%REPO_DIR%.opencode\reports" (
        rmdir /S /Q "%REPO_DIR%.opencode\reports"
        echo  Removed: .opencode\reports\
    )
    if exist "%REPO_DIR%.opencode\todo.md" (
        del "%REPO_DIR%.opencode\todo.md"
        echo  Removed: .opencode\todo.md
    )
    if exist "%REPO_DIR%.opencode\work-log.md" (
        del "%REPO_DIR%.opencode\work-log.md"
        echo  Removed: .opencode\work-log.md
    )
)
echo.

:: ---- Step 3: Remove graphify-out ----
echo [3/4] Removing graphify-out (knowledge graph cache)...
set /p REMOVE_GRAPH=Remove graphify-out/ directory? (y/N): 
if /i "!REMOVE_GRAPH!"=="y" (
    if exist "%REPO_DIR%graphify-out" (
        rmdir /S /Q "%REPO_DIR%graphify-out"
        echo  Removed: graphify-out\
    )
) else (
    echo  [SKIP] graphify-out\ retained.
)
echo.

:: ---- Step 4: Optionally uninstall Python packages ----
echo [4/4] Python packages...
set /p UNINSTALL_PIP=Uninstall graphify, pytest, jsonschema? (y/N): 
if /i "!UNINSTALL_PIP!"=="y" (
    echo  Uninstalling graphify...
    pip uninstall graphify -y >nul 2>&1
    echo  Uninstalling pytest...
    pip uninstall pytest -y >nul 2>&1
    echo  Uninstalling jsonschema...
    pip uninstall jsonschema -y >nul 2>&1
    echo  Python packages uninstalled.
) else (
    echo  [SKIP] Python packages retained.
)
echo.

echo ============================================
echo  Local uninstall complete!
echo ============================================
echo.
echo  Remaining (not removed):
echo    - .gitignore
echo    - Git repository
echo    - Python packages (if you chose to keep them)
echo.
echo  To reinstall later, run: setup.bat
echo.
pause
